# Gitignored — real credentials, never commit.
#
# Read-only source for `npm run pull:db`. The running site uses a LOCAL database
# (credentials are in docker-compose.yml), so nothing here is used at runtime.

# Shell host that is allowed to reach the prod MySQL.
PROD_SSH=user@shell.example.com

PROD_DB_HOST=mysql.example.com
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=

# Remote site root (or wp-content itself) for `pull:files`. Leave empty to let
# the script look for ~/*/wp-content on the remote host.
PROD_WP_DIR=
