# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# These point at the PRODUCTION database. Anything you change while browsing
# localhost:8300 changes the live site's data. See CLAUDE.md.

# Direct connection (requires the prod host to allow remote MySQL from your IP):
DEYUTCM_DB_HOST=mysql.example.com:3306

# Or, over an SSH tunnel started on the Mac, e.g.
#   ssh -N -L 3307:mysql.example.com:3306 fatfat@iad1-shared-b8-32.dreamhost.com
# then use:
# DEYUTCM_DB_HOST=host.docker.internal:3307

DEYUTCM_DB_NAME=
DEYUTCM_DB_USER=
DEYUTCM_DB_PASSWORD=

# Table prefix as it exists in the prod database (defaults to wp_).
DEYUTCM_DB_PREFIX=wp_
